{
  "name": "sg-air-quality-monitor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"**/*.test.ts\"",
    "dev:server": "node --watch server/main.ts",
    "dev:web": "vite",
